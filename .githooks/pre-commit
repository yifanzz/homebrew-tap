#!/usr/bin/env bash
# Cross-project pre-commit baseline: lint + typecheck + fast tests.
# Managed by project-sync (template lives in ~/code/project-sync/templates/).
# Customize freely — project-sync reports customized files, never overwrites.
# Activate with: git config core.hooksPath .githooks
set -euo pipefail

# In a linked worktree git exports GIT_DIR, GIT_INDEX_FILE and friends to this
# hook, so a test that makes a scratch repository would re-initialise this one
# (core.bare=true stops every checkout). Tests run without them, and a flip
# fails the commit after resetting it.
scrub=(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR
  -u GIT_PREFIX -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES)
check_bare() {
  if [ "$(git config --get core.bare 2>/dev/null)" = "true" ]; then
    git config core.bare false
    echo "pre-commit: a test set core.bare=true on this repository; reset it to false. Make the test leave this repository alone." >&2
    exit 1
  fi
}
trap check_bare EXIT

if [ -f package.json ]; then
  pm=npm
  [ -f pnpm-lock.yaml ] && pm=pnpm
  [ -f yarn.lock ] && pm=yarn
  for s in lint typecheck test; do
    if command -v jq >/dev/null 2>&1 && jq -e --arg s "$s" '.scripts[$s] // empty' package.json >/dev/null; then
      if [ "$s" = test ]; then "${scrub[@]}" "$pm" run "$s"; else "$pm" run "$s"; fi
    fi
  done
elif [ -f go.mod ]; then
  unformatted=$(gofmt -l . 2>/dev/null | grep -v '^vendor/' || true)
  if [ -n "$unformatted" ]; then
    echo "gofmt needed:" >&2
    echo "$unformatted" >&2
    exit 1
  fi
  go vet ./...
  "${scrub[@]}" go test ./...
elif [ -f pyproject.toml ] || [ -f ruff.toml ]; then
  command -v ruff >/dev/null 2>&1 && ruff check .
  if [ -d tests ] && command -v pytest >/dev/null 2>&1; then
    "${scrub[@]}" pytest -q -x
  fi
fi
